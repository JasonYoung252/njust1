<launch>
    <!-- 启动rm_driver包中的rm_63_driver.launch -->
    <include file="$(find rm_driver)/launch/rm_63_driver.launch" />
    
    <!-- 启动njust包中的arm_control节点 -->
    <node name="arm_control" pkg="njust" type="arm_control.py" output="screen" />
    
    <!-- 启动njust包中的target_position节点 -->
    <node name="target_position" pkg="njust" type="target_position.py" output="screen" />
</launch>